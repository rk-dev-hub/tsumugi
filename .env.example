# このファイルをコピーして .env を作る:  cp .env.example .env
# 値はローカルで試すためのダミー。

# PostgreSQL 接続文字列（docker compose の DB は localhost:5435）
DATABASE_URL="postgresql://tsumugi:tsumugi@localhost:5435/tsumugi?schema=public"

# ポートが他と競合する場合に変更する（DB_PORT を変えたら DATABASE_URL も合わせる）
# DB_PORT=5435
# APP_PORT=3300

# Auth.js のセッション署名鍵と、2 段階認証のシークレットの暗号化鍵。
# docker compose up では、このダミー値のままなら自動で生成した値を使う。
# pnpm dev で使う場合は、次のコマンドで生成した値に置き換える:  openssl rand -base64 32
AUTH_SECRET="dummy-dummy-dummy-dummy-dummy-dummy-32ch"
AUTH_URL="http://localhost:3300"
APP_URL="http://localhost:3300"

# CSV 既定エンコーディング:  utf8 | utf8-bom | shift_jis
CSV_ENCODING="utf8-bom"

# AI アシスタント Tsumugi を使う場合だけ、Claude API キーを設定する（https://platform.claude.com で発行）。
# 空のままでも動作し、Tsumugi の文面はテンプレートになる（ひとこと入力は使えない）。
ANTHROPIC_API_KEY=""
# 使うモデルと、1 人 1 日あたりの利用回数の上限
TSUMUGI_AI_MODEL="claude-haiku-5-5"
TSUMUGI_AI_DAILY_LIMIT="60"
